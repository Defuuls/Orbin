<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon a fresh install shows: `AppIconVariant.DEFAULT` is the only alias enabled in the
  manifest, so this drawable, not `@mipmap/ic_launcher`, is what ends up on the launcher.

  It is an adaptive icon now rather than a bare vector, which is what lets the launcher mask it to
  its own shape and lets Android 13 draw it as a themed icon. What it replaced was seven paths of
  hairline strokes and four alpha levels in a 256 viewport — around half a pixel wide once scaled
  to a launcher, so most of the drawing simply was not there at the size anyone saw it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_orbit_background" />
    <foreground android:drawable="@drawable/ic_launcher_orbit_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_orbit_foreground" />
</adaptive-icon>

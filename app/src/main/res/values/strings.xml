<resources>
    <string name="app_name">Orbin</string>

    <!-- Safe mode: shown when consecutive launches crashed during startup. -->
    <string name="safe_mode_title">Orbin didn\'t start</string>
    <string name="safe_mode_explanation">The last two launches stopped before the app was usable, so it\'s starting in safe mode instead of trying again.</string>
    <string name="safe_mode_save_first">Saving the crash details first is worth doing even if you plan to reset — it\'s the only record of what went wrong, and it stays on your device until you share it.</string>
    <string name="safe_mode_save_crash_details">Save crash details</string>
    <string name="safe_mode_reset">Reset local data</string>
    <string name="safe_mode_try_normally">Try starting normally</string>
    <string name="safe_mode_reset_dialog_title">Reset local data?</string>
    <string name="safe_mode_reset_dialog_text">Deletes bookmarks, reading history, saved searches and download history from this device. Your settings are kept. This cannot be undone.</string>
    <string name="safe_mode_reset_confirm">Reset</string>
    <string name="safe_mode_cancel">Cancel</string>
    <string name="downgrade_blocked_title">This version can\'t run</string>
    <string name="downgrade_blocked_explanation">A newer version of Orbin has already run on this device. Once you\'ve updated, older versions can no longer be used.</string>
    <!-- %1$d is the running build's version code, %2$d the newest one that has run on this device. -->
    <string name="downgrade_blocked_versions">This build is version %1$d. The newest one used here is version %2$d.</string>
    <string name="downgrade_blocked_next_step">Install version %1$d or newer to keep using Orbin.</string>
    <string name="downgrade_blocked_close">Close</string>

